# Add project specific R8 rules here.
# AGP will combine all keep rule files in src/main/keepRules to pass to R8
#
# For more details, see
#   https://d.android.com/r/tools/r8/keep-rules

# If your project uses WebView with JS, uncomment the following
# and specify the fully qualified class name to the JavaScript interface
# class:
#-keepclassmembers class fqcn.of.javascript.interface.for.webview {
#   public *;
#}

# WorkManager membuat instance Worker lewat reflection (Class.forName + constructor
# (Context, WorkerParameters)) berdasarkan nama class yang disimpan di WorkRequest.
# R8 tidak bisa lihat pemanggilan ini lewat analisis reachability biasa, jadi semua
# subclass ListenableWorker (termasuk CoroutineWorker) di app ini WAJIB di-keep,
# kalau tidak app akan crash saat runtime (ClassNotFoundException) walau build sukses.
-keep public class * extends androidx.work.ListenableWorker {
    public <init>(android.content.Context, androidx.work.WorkerParameters);
}

# ---- ML Kit: HARUS cover com.google.mlkit.** secara PENUH, bukan cuma ----
# ---- com.google.mlkit.vision.** -- MlKitInitProvider dan sistem dependency-----
# ---- injection internalnya (ComponentRegistrar, Component, dll) ada di ----
# ---- package com.google.mlkit.common.internal, yang KELUAR dari cakupan ----
# ---- "vision.**" saja. Kalau cuma vision.** yang di-keep, provider ini gagal ----
# ---- di-inject saat app startup -> RuntimeException/NPE persis saat ----
# ---- BarcodeScanning.getClient() pertama kali dipanggil (lihat riwayat crash ----
# ---- sebelumnya: "Unable to get provider com.google.mlkit.common.internal.MlKitInitProvider").
-keep class com.google.mlkit.** { *; }
-dontwarn com.google.mlkit.**

# ---- Modul internal Play Services untuk Barcode Scanning (varian unbundled/ ----
# ---- Dynamite) -- di-load reflection saat runtime, wajib di-keep utuh. ----
-keep class com.google.android.gms.internal.mlkit_vision_barcode.** { *; }
-keep class com.google.android.gms.internal.mlkit_vision_common.** { *; }
-dontwarn com.google.android.gms.internal.mlkit_vision_barcode.**
-dontwarn com.google.android.gms.internal.mlkit_vision_common.**

# ---- Safety net: MlKitInitProvider di-bootstrap lewat sistem dependency- ----
# ---- injection generik milik Play Services yang dipakai bersama oleh modul ----
# ---- GMS lain di app ini (Auth, Location, dll) -- kalau class DI generiknya ----
# ---- ikut ter-strip, provider APA PUN yang pakai mekanisme sama bisa crash ----
# ---- serupa, bukan cuma barcode. ----
-keep class com.google.android.gms.common.internal.** { *; }
-dontwarn com.google.android.gms.common.internal.**

# ---- ZXing: dipakai untuk GENERATE QR (PhotoIntegrity.kt). ----
-keep class com.google.zxing.** { *; }
-dontwarn com.google.zxing.**

# ---- CameraX: ImageAnalysis + analyzer callback, sebagian wiring internalnya ----
# ---- reflection-based dan rawan di-strip kalau full R8 mode aktif. ----
-keep class androidx.camera.** { *; }
-dontwarn androidx.camera.**